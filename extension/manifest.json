{
  "manifest_version": 3,
  "name": "VoiceDock",
  "version": "1.1.0",
  "description": "Highlight text and hear it read aloud by local Piper or Kokoro voices. No cloud, no API keys.",
  "permissions": [
    "contextMenus",
    "tts",
    "storage",
    "tabs",
    "offscreen"
  ],
  "host_permissions": [
    "http://127.0.0.1:7477/*",
    "http://127.0.0.1:7478/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "VoiceDock"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "read-selection": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Read selected text or stop playback"
    },
    "pause-resume": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Pause or resume playback"
    }
  },
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png",
    "512": "icons/icon512.png"
  }
}
